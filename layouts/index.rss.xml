{{- /*
  Site RSS feed (/index.xml). Based on Hugo's built-in RSS template, with two additions
  that the Buttondown RSS-to-email automation reads (see buttondown/rss-email-template.html):
  - <description>: a plain-text teaser from front matter "teaser" or the first paragraphs,
    skipping the lead image and photo credit ({{ item.description }}).
  - <media:content medium="image">: the post's preview image as an absolute URL ({{ item.enclosure }}).
    Buttondown leaves {{ item.enclosure }} empty for a plain RSS <enclosure>, so the image is MediaRSS.
*/ -}}
{{- $pages := where site.RegularPages "Section" "posts" -}}
{{- $limit := site.Config.Services.RSS.Limit -}}
{{- if ge $limit 1 }}{{ $pages = $pages | first $limit }}{{ end -}}
{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom" xmlns:dc="http://purl.org/dc/elements/1.1/" xmlns:media="http://search.yahoo.com/mrss/">
  <channel>
    <title>{{ site.Title }}</title>
    <link>{{ .Permalink }}</link>
    <description>{{ site.Params.description }}</description>
    <generator>Hugo</generator>
    <language>{{ site.Language.LanguageCode }}</language>
    {{- with site.Params.author }}
    <copyright>© {{ now.Year }} {{ . }}</copyright>
    {{- end }}
    {{- if not .Date.IsZero }}
    <lastBuildDate>{{ (index $pages.ByLastmod.Reverse 0).Lastmod.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</lastBuildDate>
    {{- end }}
    <image>
      <url>{{ "apple-touch-icon.png" | absURL }}</url>
      <title>{{ site.Title }}</title>
      <link>{{ .Permalink }}</link>
    </image>
    {{- with .OutputFormats.Get "RSS" }}
    {{ printf "<atom:link href=%q rel=\"self\" type=%q />" .Permalink .MediaType | safeHTML }}
    {{- end }}
    {{- range $pages.ByDate.Reverse }}
    {{- /* Teaser: front matter "teaser" if set, else the first real paragraphs, ~60 words. */ -}}
    {{- $words := slice -}}
    {{- $paras := findRE `(?s)<p>.*?</p>` .Content -}}
    {{- with .Params.teaser }}{{ $paras = slice (. | markdownify | printf "<p>%s</p>") }}{{ end -}}
    {{- range $paras -}}
      {{- if ge (len $words) 40 }}{{ break }}{{ end -}}
      {{- if in . "<img" }}{{ continue }}{{ end -}}
      {{- $inner := strings.TrimSuffix "</p>" (strings.TrimPrefix "<p>" .) | strings.TrimSpace -}}
      {{- /* Photo credits are a paragraph that is entirely italic. */ -}}
      {{- if and (strings.HasPrefix $inner "<em>") (strings.HasSuffix $inner "</em>") }}{{ continue }}{{ end -}}
      {{- $words = $words | append (split (plainify $inner | htmlUnescape) " ") -}}
    {{- end -}}
    {{- $max := cond (isset .Params "teaser") 1000 60 -}}
    {{- $teaser := delimit (first $max $words) " " -}}
    {{- if gt (len $words) $max }}{{ $teaser = print $teaser " …" }}{{ end }}
    <item>
      <title>{{ .Title }}</title>
      <link>{{ .Permalink }}</link>
      <pubDate>{{ .PublishDate.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</pubDate>
      {{- with site.Params.author }}
      <dc:creator>{{ . }}</dc:creator>
      {{- end }}
      <guid>{{ .Permalink }}</guid>
      <description>{{ $teaser }}</description>
      {{- with partial "preview-image.html" . }}
      {{- $url := . | absURL -}}
      {{- $ext := path.Ext $url | lower | strings.TrimPrefix "." -}}
      {{- $type := index (dict "jpg" "image/jpeg" "jpeg" "image/jpeg" "png" "image/png" "gif" "image/gif" "webp" "image/webp") $ext | default "image/jpeg" -}}
      <media:content url="{{ $url }}" medium="image" type="{{ $type }}" />
      {{- end }}
    </item>
    {{- end }}
  </channel>
</rss>
